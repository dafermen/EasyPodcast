# Copy to repository-root .env; backend only. Never commit real secrets.
OPENAI_API_KEY=
# Choose an image model accessible to your account. No paid call at startup.
IMAGE_MODEL=
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium
# Executable names in PATH or absolute paths.
FFMPEG=ffmpeg
FFPROBE=ffprobe
NODE=node
# Optional persistent model cache; never a user-media folder.
# TRANSCRIPTION_CACHE=C:/Users/your_user/.cache/easypodcast/models
TRANSCRIPTION_ALLOW_DOWNLOAD=true
# Exclusive, initially empty directory outside the repository. Defaults to OS temp/easypodcast.
# TEMP_ROOT=C:/Users/your_user/AppData/Local/Temp/easypodcast
MAX_AUDIO_BYTES=1073741824
MAX_SRT_BYTES=5242880
MAX_IMAGE_BYTES=20971520
MAX_PIXELS=25000000
MAX_DURATION=7200
TTL_SECONDS=86400
FAILURE_TTL_SECONDS=900
ACTIVE_TTL_SECONDS=14400
QUEUE_SIZE=2
MAX_JOBS=8
MIN_FREE_BYTES=536870912
# JSON allowlist. Vite proxies /api; no wildcard CORS is needed.
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
