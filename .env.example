# Copia como .env en la raíz. Solo el backend lee estos valores.
# Opcional: clave real únicamente aquí, nunca en frontend o Git.
OPENAI_API_KEY=
# Selecciona un modelo GPT Image accesible en tu cuenta. No se hacen llamadas al iniciar.
# Referencia de contrato: docs/OPENAI_PROVIDER.md
IMAGE_MODEL=
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium
# Ejecutables presentes en PATH; también admiten rutas absolutas.
FFMPEG=ffmpeg
FFPROBE=ffprobe
# Transcripción local opcional; instala con npm ci dentro de transcription.
NODE=node
# Caché persistente de modelos, sin medios de usuario; por defecto ~/.cache/easypodcast/models.
# TRANSCRIPTION_CACHE=C:/Users/tu_usuario/.cache/easypodcast/models
TRANSCRIPTION_ALLOW_DOWNLOAD=true
# TEMP_ROOT opcional: por defecto carpeta easypodcast en el temporal del sistema.
# Debe ser una carpeta exclusiva, inicialmente vacía, fuera del repositorio.
# TEMP_ROOT=C:/Users/tu_usuario/AppData/Local/Temp/easypodcast
MAX_AUDIO_BYTES=1073741824
MAX_SRT_BYTES=5242880
MAX_IMAGE_BYTES=20971520
MAX_PIXELS=25000000
MAX_DURATION=7200
TTL_SECONDS=3600
FAILURE_TTL_SECONDS=900
ACTIVE_TTL_SECONDS=14400
QUEUE_SIZE=2
MAX_JOBS=8
MIN_FREE_BYTES=536870912
# JSON; no añadir wildcard. Vite hace proxy, no se necesita CORS.
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
